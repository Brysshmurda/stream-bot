# ── Twitch ──────────────────────────────────────────────────────────────
# Create an app at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# User access token for the broadcaster account.
# Required scopes: channel:read:subscriptions moderator:read:followers
#                  bits:read channel:read:redemptions
# Get one at: https://twitchtokengenerator.com  (paste both tokens below)
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=

# Your Twitch channel name (lowercase) and numeric user ID
# Find your user ID at: https://www.streamweasels.com/tools/convert-twitch-username-to-user-id/
TWITCH_CHANNEL_NAME=
TWITCH_BROADCASTER_ID=

# Optional: a separate bot account for chat commands.
# If left blank, the broadcaster account is used for chat.
TWITCH_BOT_USERNAME=
TWITCH_BOT_TOKEN=

# ── Discord ──────────────────────────────────────────────────────────────
# Create a bot at https://discord.com/developers/applications
# Required intents: Guilds, GuildMembers, GuildMessages, MessageContent
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Optional role/channel IDs — leave blank to skip that feature.
# These can also be configured via the /setup command in Discord.
DISCORD_ANNOUNCE_CHANNEL_ID=
DISCORD_FOLLOWER_ROLE_ID=
DISCORD_SUBSCRIBER_ROLE_ID=
DISCORD_LIVE_ROLE_ID=

# ── Database ─────────────────────────────────────────────────────────────
DB_PATH=./data/streams.db
